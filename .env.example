# Copy to .env to override defaults used by compose.yaml.
# Paths to sibling repositories (defaults assume all repos are cloned side by side).
AUTH_SERVICE_PATH=../ecommerce-auth-service
PRODUCT_SERVICE_PATH=../ecommerce-product-service
INVENTORY_SERVICE_PATH=../ecommerce-inventory-service
ORDER_SERVICE_PATH=../ecommerce-order-service
PAYMENT_SERVICE_PATH=../ecommerce-payment-service
NOTIFICATION_SERVICE_PATH=../ecommerce-notification-service
SAGA_ORCHESTRATOR_PATH=../ecommerce-saga-orchestrator
FRONTEND_PATH=../ecommerce-frontend

# Only needed if you switch LocalStack to a calendar-versioned (2026.x) image.
LOCALSTACK_AUTH_TOKEN=
